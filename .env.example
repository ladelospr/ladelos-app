# ---- Supabase (publicas: viajan al navegador) ----
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# NOTA: la llave de Anthropic y las credenciales de Clover NO van aqui.
# Todo lo que empieza con VITE_ se empaqueta en el bundle y queda visible
# para cualquiera que abra la app. Ambas viven como secretos de sus
# respectivos Edge Functions:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy process-receipt
#
#   supabase secrets set CLOVER_API_TOKEN=...
#   supabase secrets set CLOVER_MERCHANT_ID=...
#   supabase functions deploy clover-sync
