# ---- Supabase (publicas: viajan al navegador) ----
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ---- Clover ----
VITE_CLOVER_API_TOKEN=tu-token-de-clover
VITE_CLOVER_MERCHANT_ID=tu-merchant-id

# NOTA: la llave de Anthropic NO va aqui.
# Todo lo que empieza con VITE_ se empaqueta en el bundle y queda visible
# para cualquiera que abra la app. La llave vive como secreto del Edge
# Function process-receipt:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
